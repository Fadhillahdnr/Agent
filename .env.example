# === Folder project yang akan diindeks (di-mount READ-ONLY). Path absolut host, tanpa tanda kutip.
# macOS/Linux: /Users/nama/Projects     Windows: C:/Users/nama/Projects
PROJECTS_PATH=./examples

# === Web chat (hanya terbuka di localhost)
WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Token rahasia antara bot Telegram dan API (isi string acak panjang)
INTERNAL_API_TOKEN=
SECURE_COOKIES=false

# === Database
POSTGRES_PASSWORD=

# === Model AI: anthropic | openai (endpoint OpenAI-compatible, termasuk Ollama) | offline (retrieval saja, tanpa model)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_BASE_URL=https://api.openai.com/v1     (Ollama di host: http://host.docker.internal:11434/v1)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# === Telegram (opsional). ID numerik user yang diizinkan, pisahkan dengan koma.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=

# === Embedding: fastembed (multibahasa, lokal) | hash (tes/offline)
EMBEDDING_PROVIDER=fastembed

# === Tuning (opsional)
SCAN_INTERVAL_SECONDS=60
# Skor kemiripan minimum agar hasil semantic dipakai (0-1)
SEMANTIC_MIN_SCORE=0.30
MAX_FILE_BYTES=1000000
GIT_MAX_COMMITS=2000
RATE_LIMIT_MEMBER_PER_MIN=20
RATE_LIMIT_VIEWER_PER_MIN=8
